generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                           String    @id @default(cuid())
  email                        String    @unique
  name                         String
  role                         String    @default("admin")
  passwordHash                 String?
  salt                         String?
  authProvider                 String    @default("email")
  googleId                     String?   @unique
  emailVerified                Boolean   @default(false)
  emailVerificationToken       String?   @unique
  emailVerificationExpiresAt   DateTime?
  emailVerificationLastSentAt  DateTime?
  emailVerificationSendCount   Int       @default(0)
  emailVerificationWindowStart DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  lessons                        Lesson[]                          @relation("LessonAuthor")
  learnerLessonVocabularyEntries LearnerLessonVocabularyEntry[]
  vocabularyReviewDecisions      LearnerVocabularyReviewDecision[]
  progressEvents                 LearnerProgressEvent[]
  refreshTokens                  AuthRefreshToken[]
}

model Lesson {
  id                             String                            @id @default(cuid())
  title                          String
  description                    String?
  status                         LessonStatus                      @default(DRAFT)
  publishedAt                    DateTime?
  createdAt                      DateTime                          @default(now())
  updatedAt                      DateTime                          @updatedAt
  authorId                       String
  author                         User                              @relation("LessonAuthor", fields: [authorId], references: [id])
  items                          LessonItem[]
  vocabularyEntries              LessonVocabularyEntry[]
  learnerLessonVocabularyEntries LearnerLessonVocabularyEntry[]
  vocabularyReviewDecisions      LearnerVocabularyReviewDecision[]
}

model LessonItem {
  id                String                  @id @default(cuid())
  lessonId          String
  lesson            Lesson                  @relation(fields: [lessonId], references: [id])
  order             Int
  text              String
  audioUrl          String
  segments          Json
  wordTimings       Json                    @default("[]")
  sentenceTimings   Json                    @default("[]")
  chunkTimings      Json                    @default("[]")
  archivedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  vocabularyEntries LessonVocabularyEntry[] @relation("LessonItemVocabularySource")
  textWorkspace     TextWorkspace?

  @@unique([lessonId, order])
}

enum LessonStatus {
  DRAFT
  PUBLISHED
}

enum VocabularyKind {
  WORD
  PHRASE
  SENTENCE
}

model LessonVocabularyEntry {
  id                  String                            @id @default(cuid())
  lessonId            String
  lesson              Lesson                            @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sourceItemId        String?
  sourceItem          LessonItem?                       @relation("LessonItemVocabularySource", fields: [sourceItemId], references: [id], onDelete: SetNull)
  englishText         String
  normalizedText      String
  focusText           String?
  focusNormalizedText String?
  kind                VocabularyKind                    @default(WORD)
  order               Int
  notes               String?
  tags                String[]
  translations        LessonVocabularyTranslation[]
  learnerStatuses     LearnerLessonVocabularyEntry[]
  reviewDecisions     LearnerVocabularyReviewDecision[]
  createdAt           DateTime                          @default(now())
  updatedAt           DateTime                          @updatedAt

  @@unique([lessonId, normalizedText])
  @@unique([lessonId, order])
  @@index([lessonId, sourceItemId])
}

model LessonVocabularyTranslation {
  id           String                @id @default(cuid())
  entryId      String
  entry        LessonVocabularyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  languageCode String
  translation  String
  usageExample String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([entryId, languageCode])
}

model LearnerLessonVocabularyEntry {
  id             String                        @id @default(cuid())
  userId         String
  user           User                          @relation(fields: [userId], references: [id])
  lessonId       String
  lesson         Lesson                        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  entryId        String
  entry          LessonVocabularyEntry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  status         LearnerLessonVocabularyStatus @default(NEW)
  correctStreak  Int                           @default(0)
  rightSwipes    Int                           @default(0)
  leftSwipes     Int                           @default(0)
  lastReviewedAt DateTime?
  firstSeenAt    DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  @@unique([userId, lessonId, entryId])
  @@index([userId, lessonId, status])
  @@index([lessonId, entryId])
}

enum LearnerLessonVocabularyStatus {
  NEW
  LEARNING
  LEARNED
}

model LearnerVocabularyReviewDecision {
  id                     String                        @id @default(cuid())
  userId                 String
  user                   User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId               String
  lesson                 Lesson                        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  entryId                String
  entry                  LessonVocabularyEntry         @relation(fields: [entryId], references: [id], onDelete: Cascade)
  decision               VocabularyReviewDecision
  idempotencyKey         String
  resultingStatus        LearnerLessonVocabularyStatus
  resultingCorrectStreak Int
  resultingRightSwipes   Int
  resultingLeftSwipes    Int
  reviewedAt             DateTime
  createdAt              DateTime                      @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, lessonId, createdAt])
  @@index([entryId])
}

enum VocabularyReviewDecision {
  AGAIN
  KNOW
}

model LearnerProgressEvent {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  lessonId        String
  lessonItemId    String?
  eventType       ProgressEventType
  completion      Int?
  clientTimestamp DateTime?
  idempotencyKey  String            @unique
  payload         Json?
  createdAt       DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([lessonId, createdAt])
}

enum ProgressEventType {
  ITEM_STARTED
  ITEM_COMPLETED
  LESSON_COMPLETED
}

model AppSettings {
  id                          String   @id @default("global")
  readingModes                Json     @default("[{\"id\":\"introduction\",\"enabled\":true,\"displayName\":\"Introduction\",\"order\":0},{\"id\":\"teaching\",\"enabled\":true,\"displayName\":\"Teaching\",\"order\":1,\"unknownWordRepetitions\":5},{\"id\":\"deep_learning\",\"enabled\":true,\"displayName\":\"Deep Learning\",\"order\":2,\"unknownWordRepetitions\":5,\"repeatSentenceWhenUnknownCountAtLeast\":2,\"sentenceRepetitions\":2}]")
  mainTextFontFamily          String   @default("System")
  mainTextFontSize            Int      @default(18)
  translationFontFamily       String   @default("System")
  translationFontSize         Int      @default(12)
  translationFontMinSize      Int      @default(8)
  translationFontMaxSize      Int      @default(15)
  translationLetterSpacingMin Float    @default(-0.2)
  translationLetterSpacingMax Float    @default(0.8)
  wordRepetitionPauseMs       Int      @default(800)
  updatePolicyEnabled         Boolean  @default(false)
  latestAndroidBuildNumber    Int      @default(0)
  minAndroidBuildNumber       Int      @default(0)
  latestIosBuildNumber        Int      @default(0)
  minIosBuildNumber           Int      @default(0)
  androidStoreUrl             String   @default("https://play.google.com/store/apps/details?id=com.nsappsdev.language")
  iosStoreUrl                 String   @default("")
  updateMessage               String   @default("A newer app version is available.")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Text/audio authoring (additive, admin-only). See B/docs/text-audio-authoring.md.
// Every model below is new; nothing here is read by existing learner routes.
// ---------------------------------------------------------------------------

model TextWorkspace {
  textId                 String    @id
  item                   LessonItem @relation(fields: [textId], references: [id], onDelete: Cascade)
  draftVersion            Int       @default(1)
  currentContentRevisionId String?
  currentNarrationId      String?
  currentAlignmentId      String?
  approvedTextReleaseId   String?
  archivedAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  contentRevisions TextContentRevision[]
  narrations       TextNarration[]
  alignments       TextAlignment[]
  vocabularyEntries TextVocabularyEntry[]
  audioAssets      AudioAsset[]
  jobs             AudioJob[]
  releases         TextRelease[]
  wordClips        WordClip[]
}

model TextContentRevision {
  id           String        @id @default(cuid())
  textId       String
  workspace    TextWorkspace @relation(fields: [textId], references: [textId], onDelete: Cascade)
  sequence     Int
  text         String
  textSha256   String
  sourceLanguage String      @default("en")
  authorId     String
  createdAt    DateTime      @default(now())

  narrations   TextNarration[]
  alignments   TextAlignment[]

  @@unique([textId, sequence])
}

enum AudioAssetKind {
  NARRATION
  WORD_CLIP
  LEGACY_REFERENCE
}

enum AudioAssetState {
  STAGED
  READY
  QUARANTINED
  DELETED
}

model AudioAsset {
  id          String           @id @default(cuid())
  textId      String
  workspace   TextWorkspace    @relation(fields: [textId], references: [textId], onDelete: Cascade)
  kind        AudioAssetKind
  storageKey  String           @unique
  mimeType    String
  byteLength  Int
  sha256      String
  sampleRate  Int?
  channels    Int?
  bitDepth    Int?
  frameCount  Int?
  state       AudioAssetState  @default(STAGED)
  createdAt   DateTime         @default(now())

  narrations  TextNarration[]
  wordClips   WordClip[]

  @@index([textId, kind])
}

model TextNarration {
  id                String        @id @default(cuid())
  textId            String
  workspace         TextWorkspace @relation(fields: [textId], references: [textId], onDelete: Cascade)
  contentRevisionId String
  contentRevision   TextContentRevision @relation(fields: [contentRevisionId], references: [id])
  assetId           String
  asset             AudioAsset    @relation(fields: [assetId], references: [id])
  jobId             String
  provider          String
  model             String
  voiceId           String
  requestSettings   Json
  inputTextSha256   String
  rawAlignment      Json
  createdAt         DateTime      @default(now())

  alignments TextAlignment[]
  wordClips  WordClip[]

  @@index([textId, createdAt])
}

enum TextAlignmentStatus {
  OK
  NEEDS_REVIEW
}

model TextAlignment {
  id                String              @id @default(cuid())
  textId            String
  workspace         TextWorkspace       @relation(fields: [textId], references: [textId], onDelete: Cascade)
  contentRevisionId String
  contentRevision   TextContentRevision @relation(fields: [contentRevisionId], references: [id])
  narrationId       String
  narration         TextNarration       @relation(fields: [narrationId], references: [id])
  algorithmVersion  Int                 @default(1)
  status            TextAlignmentStatus
  sentences         Json
  diagnostics       Json
  createdAt         DateTime            @default(now())

  occurrences WordOccurrence[]
  entries     TextVocabularyEntry[]
  wordClips   WordClip[]

  @@index([textId, createdAt])
}

enum OccurrenceMappingStatus {
  MAPPED
  UNMAPPED
}

model WordOccurrence {
  id                String        @id @default(cuid())
  alignmentId       String
  alignment         TextAlignment @relation(fields: [alignmentId], references: [id], onDelete: Cascade)
  ordinal           Int
  sentenceId         String
  charStart          Int
  charEnd            Int
  surfaceText         String
  normalizedText       String
  speechStartSample   Int?
  speechEndSample     Int?
  cutStartSample      Int?
  cutEndSample        Int?
  mappingStatus       OccurrenceMappingStatus

  @@unique([alignmentId, ordinal])
  @@index([alignmentId, charStart])
}

model TextVocabularyEntry {
  id           String        @id @default(cuid())
  textId       String
  workspace    TextWorkspace @relation(fields: [textId], references: [textId], onDelete: Cascade)
  alignmentId  String
  alignment    TextAlignment @relation(fields: [alignmentId], references: [id], onDelete: Cascade)
  occurrenceId String
  selected     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  archivedAt   DateTime?

  translations TextVocabularyTranslation[]
  wordClips    WordClip[]

  @@unique([alignmentId, occurrenceId])
  @@index([textId])
}

model TextVocabularyTranslation {
  id           String              @id @default(cuid())
  entryId      String
  entry        TextVocabularyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  languageCode String
  translation  String
  usageExample String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([entryId, languageCode])
}

model WordClip {
  id               String        @id @default(cuid())
  textId           String
  workspace        TextWorkspace @relation(fields: [textId], references: [textId], onDelete: Cascade)
  narrationId      String
  narration        TextNarration @relation(fields: [narrationId], references: [id])
  alignmentId      String
  alignment        TextAlignment @relation(fields: [alignmentId], references: [id])
  occurrenceId     String
  entryId          String
  entry            TextVocabularyEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  assetId          String
  asset            AudioAsset    @relation(fields: [assetId], references: [id])
  startSample      Int
  endSample        Int
  extractionVersion Int          @default(1)
  createdAt        DateTime      @default(now())

  @@unique([occurrenceId, extractionVersion])
  @@index([textId])
}

model TextRelease {
  id                String   @id @default(cuid())
  textId            String
  workspace         TextWorkspace @relation(fields: [textId], references: [textId], onDelete: Cascade)
  contentRevisionId String
  narrationId       String
  alignmentId       String
  entryIds          Json
  readinessSnapshot Json
  authorId          String
  createdAt         DateTime @default(now())

  @@index([textId, createdAt])
}

enum AudioJobKind {
  GENERATE_NARRATION
  EXTRACT_CLIPS
}

enum AudioJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model AudioJob {
  id             String         @id @default(cuid())
  textId         String
  workspace      TextWorkspace  @relation(fields: [textId], references: [textId], onDelete: Cascade)
  kind           AudioJobKind
  actorId        String
  idempotencyKey String
  requestHash    String
  requestPayload Json
  status         AudioJobStatus @default(QUEUED)
  attempt        Int            @default(0)
  leaseUntil     DateTime?
  resultAssetId  String?
  resultId       String?
  errorCode      String?
  errorMessage   String?
  retryable      Boolean        @default(false)
  reservedCharacters Int        @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([textId, kind, idempotencyKey])
  @@index([status, createdAt])
}

model AuthRefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}
